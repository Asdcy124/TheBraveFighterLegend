config_version=5

[application]

config/name="TheBraveFighterLegend"
run/main_scene="uid://b5u2eynn4ql5o"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="uid://hgujprlu71d6"

[display]

window/size/viewport_width=426
window/size/viewport_height=240
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="TheBraveFighterLegend"

[file_customization]

